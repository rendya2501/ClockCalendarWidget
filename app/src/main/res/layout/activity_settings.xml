<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_title"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <!-- 都市(タイムゾーン) -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_zone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/zone_city"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <TextView
                android:id="@+id/zone_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawableTint="?android:attr/textColorSecondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <!-- 表示 -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/theme" />

            <RadioGroup
                android:id="@+id/radio_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/theme_dark" />

                <RadioButton
                    android:id="@+id/radio_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/theme_light" />

                <RadioButton
                    android:id="@+id/radio_theme_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/theme_system" />
            </RadioGroup>

            <Switch
                android:id="@+id/switch_digital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/show_digital" />

            <Switch
                android:id="@+id/switch_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/show_alarm" />

            <Switch
                android:id="@+id/switch_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/show_label" />

            <Switch
                android:id="@+id/switch_second_hand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/show_second_hand" />

            <Switch
                android:id="@+id/switch_monday_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/monday_start" />

            <Switch
                android:id="@+id/switch_swap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/swap_positions" />

            <TextView
                android:id="@+id/background_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <SeekBar
                android:id="@+id/seek_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:minHeight="48dp"
                android:progress="100" />

            <!-- タップしたときに開くアプリ -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_apps" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tap_clock" />

            <TextView
                android:id="@+id/tap_clock_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawableTint="?android:attr/textColorSecondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tap_calendar" />

            <TextView
                android:id="@+id/tap_calendar_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawableTint="?android:attr/textColorSecondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textAppearance="?android:attr/textAppearanceMedium" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>
